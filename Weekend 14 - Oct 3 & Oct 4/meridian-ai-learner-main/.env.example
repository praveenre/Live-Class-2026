# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ============================================================
# THE TOGGLE:  local | cloud
#   local -> Runs with local storage and Chroma vector database (.meridian/chroma).
#   cloud -> Runs with Pinecone Serverless cloud vector database.
# ============================================================
APP_MODE=cloud
ENVIRONMENT=local

# Vector Backend (pinecone | chroma)
VECTOR_BACKEND=pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=meridian-docs

# Model names and hyperparameters
LLM_MODEL_NAME=gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=text-embedding-005
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
LLM_TEMPERATURE=0.0

# ==============================================================================
# Mesh API Gateway (https://meshapi.ai)
# Universal OpenAI-compatible endpoint routing to 1,000+ AI models
# ==============================================================================
MESH_API_KEY=your-mesh-api-key
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=google/gemini-2.5-flash-lite
MESH_EMBEDDING_MODEL=google/text-embedding-005

# Optional direct Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# Agent middleware limits (optional, these are the defaults)
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_RETRIES=2
